# XO — Conversational AI Assistant · environment configuration
# Copy to .env (and backend/.env for local runs). Never commit real keys.
ENVIRONMENT=development
PORT=8000
# Browser origins allowed to call the API / open the voice WebSocket (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://xoto-blitz.vercel.app

# Provider keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Confirmed models
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
STT_MODEL=gpt-live-transcribe
TTS_MODEL=eleven_v4_turbo
EMBEDDING_MODEL=text-embedding-3-small
ELEVENLABS_VOICE_ID=qXpMhyvQqiRxWQs4qSSB
ELEVENLABS_VOICE_NAME="Horatius - Energetic Character voice"

# Voice behaviour
VOICE_SILENCE_SUBMIT_MS=1000
STT_DELAY=medium
# Turns down background voices and noise before transcription: near_field (phone/laptop), far_field, or empty for off
STT_NOISE_REDUCTION=near_field
TTS_MAX_CHARS=1200

# Conversation tuning
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_TOOL_STEPS=4
HISTORY_MAX_MESSAGES=24
SEARCH_MAX_RESULTS=5
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35

# Security
ADMIN_API_KEY=generate_a_long_random_value
JWT_SECRET=generate_a_long_random_value
RATE_LIMIT_PER_MINUTE=30

# Live inventory & CRM gateways
GRID_OFFPLAN_API_URL=https://xoto.ae/api/gridoffplan/website
# Public off-plan project page, e.g. https://xoto.ae/<path>/{slug}. Leave empty to hide "View details" links.
OFFPLAN_LISTING_URL_TEMPLATE=
GRID_API_URL=
GRID_API_KEY=
VAULT_API_URL=
VAULT_API_KEY=

# Lead storage (PostgreSQL). Required in production; leads are lost on restart without it.
DATABASE_URL=
POSTGRES_PASSWORD=change_me

# Compliance references
COMPANY_RETENTION_POLICY_REF=XOTO-CORP-RETENTION-POL-2024-V3
REGULATORY_SCOPE=UAE / Dubai / DIFC

# Frontend build (Vercel): WebSocket origin of the backend for live voice
# VITE_API_WS_BASE=wss://xoto-backend.onrender.com
